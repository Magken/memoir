# Copy to .env and adjust. Only VITE_* vars are exposed to the client.
VITE_APP_TITLE=Vurify
VITE_API_URL=http://localhost:3000

# Local Supabase (ports from back_end/supabase/config.toml)
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<from: npm run back_end:status>

# Hosted Supabase (after npm run back_end:link)
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<Project Settings → API Keys → publishable (sb_publishable_…)>
# Do not put the secret key (sb_secret_…) in any VITE_ var.

# Dev: log which disk files triggered each Vite HMR burst (terminal). Default on; set 0 to silence.
# VITE_HMR_TRACE=0
