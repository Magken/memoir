{
  "schemaVersion": 1,
  "kind": "interview_brief",
  "definition": {
    "meta": {
      "title": "Tiered Decision sample",
      "roleTitle": "Software engineer",
      "status": "draft",
      "roleDescription": "Coding plus a debrief talk and a short write-up. Soft score uses named folders, not the six catalog keys.",
      "candidateDescription": "You will debrief a coding drill, then write a short note.",
      "proposedMinutes": 40,
      "estimatedMinutes": 35,
      "timing": { "slackMinutes": 2, "fitPolicy": "fit_proposed" }
    },
    "persona": {
      "name": "Avery",
      "voice": "calm, precise",
      "behaviourPrompt": "Probe for concrete examples. Never coach solutions."
    },
    "systemGoals": ["Assess coding output and a written note"],
    "guardrails": ["Do not hint at hidden tests"],
    "probeDefaults": { "maxFollowUps": 1, "targetMinutes": 8, "maxProbes": 3, "minCandidateTurns": 1 }
  },
  "topicLibrary": [
    {
      "id": "topic.debrief",
      "label": "Coding debrief",
      "purpose": "Walk through the approach you took on the drill. One template counts; delivery is graded off the overall.",
      "targetMinutes": 8,
      "probes": [
        { "id": "p.approach", "goal": "Name the main approach you took.", "required": true, "order": 1 }
      ],
      "targets": [{ "key": "approach", "label": "Approach", "required": true }],
      "analysis": { "attachPack": null, "templateIds": ["iv.content.v1", "iv.delivery.v1"] }
    }
  ],
  "phases": [
    {
      "id": "ph.talk",
      "kind": "discussion",
      "title": "Coding debrief",
      "topicId": "topic.debrief",
      "estimatedMinutes": 8,
      "summary": { "blurb": "Debrief the drill. Content counts; delivery is graded but not in the overall." }
    },
    {
      "id": "ph.code",
      "kind": "tool",
      "toolRef": "tool.code",
      "title": "Coding drill",
      "required": true,
      "estimatedMinutes": 20
    },
    {
      "id": "ph.doc",
      "kind": "tool",
      "toolRef": "tool.doc",
      "title": "Written note",
      "estimatedMinutes": 7,
      "summary": { "blurb": "A short note on the tradeoff you chose." }
    }
  ],
  "tools": {
    "tool.code": {
      "type": "coding",
      "editorKind": "code",
      "title": "Two-sum drill",
      "instructions": "Return indices of two numbers that add to the target.",
      "languages": ["typescript"],
      "defaultLanguage": "typescript",
      "timing": { "mode": "timed", "estimatedMinutes": 20, "limitMinutes": 20 },
      "analysis": { "attachPack": null, "templateIds": ["mark.code.tests.v1", "mark.code.method.v1"] },
      "tests": {
        "runner": "hidden_cases_v1",
        "entryPoint": "twoSum",
        "cases": [
          { "id": "t1", "name": "basic", "args": [[2, 7, 11, 15], 9], "expected": [0, 1], "hidden": false },
          { "id": "t2", "name": "hidden", "args": [[3, 3], 6], "expected": [0, 1], "hidden": true }
        ]
      },
      "artifact": {
        "docKind": "code",
        "inline": {
          "title": "Two-sum",
          "files": [
            { "path": "README.md", "language": "markdown", "content": "# Two-sum\n\nReturn two indices.\n" },
            { "path": "src/solve.ts", "language": "typescript", "content": "export function twoSum(nums: number[], target: number): number[] {\n  return [0, 1]\n}\n" }
          ],
          "folders": ["src", "tests"],
          "openIds": ["README.md", "src/solve.ts"],
          "activeId": "src/solve.ts"
        }
      }
    },
    "tool.doc": {
      "type": "doc",
      "editorKind": "doc",
      "title": "Tradeoff note",
      "instructions": "Write a short note on the tradeoff.",
      "timing": { "mode": "untimed", "estimatedMinutes": 7 },
      "analysis": { "attachPack": null, "templateIds": ["mark.doc.essay.v1"] },
      "prompt": {
        "brief": "What tradeoff did you accept and why?",
        "structure": [{ "id": "s.tradeoff", "label": "Tradeoff", "minParagraphs": 1 }],
        "requirements": ["Name one concrete tradeoff"]
      },
      "assessment": {
        "kind": "rubric",
        "dimensions": [
          {
            "key": "task",
            "label": "Task response",
            "weight": 1,
            "bands": [
              { "id": "b1", "label": "1 — Weak", "descriptor": "Misses the tradeoff" },
              { "id": "b2", "label": "2 — Mixed", "descriptor": "Names it thinly" },
              { "id": "b3", "label": "3 — Strong", "descriptor": "Names a concrete tradeoff" }
            ]
          }
        ]
      },
      "artifact": {
        "docKind": "doc",
        "inline": { "title": "Tradeoff note", "markdown": "## Prompt\n\nWhat tradeoff did you accept?\n" }
      }
    }
  },
  "analysis": {
    "rollup": {
      "templateId": "rollup.attempt.v1",
      "weights": {
        "coding-approach": 0.6,
        "write": 0.4
      },
      "weightSections": {
        "coding-approach": ["ph.code", "ph.talk"],
        "write": ["ph.doc"]
      },
      "weightLabels": {
        "coding-approach": "Coding approach",
        "write": "Writing"
      },
      "templateWeights": {
        "ph.talk": { "iv.delivery.v1": 0 },
        "ph.code": { "mark.code.method.v1": 0 }
      }
    },
    "schedule": {
      "interview_end": { "when": "interview_end", "templateIds": ["rollup.attempt.v1"] }
    },
    "overrides": {
      "libraryIds": ["iv.content.v1", "iv.delivery.v1", "synth.topic.v1"]
    }
  },
  "timingSummary": { "estimatedMinutes": 35, "proposedMinutes": 40, "sumSections": 35, "slackMinutes": 2, "fitsProposed": true }
}
